{
  "name": "tmods-downloader",
  "version": "0.3.1",
  "main": "./build/electron.js",
  "author": "Trino",
  "description": "A minecraft mods manager",
  "private": true,
  "homepage": "./",
  "scripts": {
    "start": "concurrently -k \"npm run start-react\" \"npm run start-electron\"",
    "start-react": "vite",
    "start-electron": "electron .",
    "build": "npm run build-react && npm run dist",
    "build-react": "vite build",
    "test": "jest",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.trinohost.tmod_loader",
    "productName": "Tmods Downloader",
    "publish": [
      {
        "provider": "github",
        "owner": "Trino11",
        "repo": "TMods-Downloader",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "artifactName": "Tmods-Downloader.${ext}"
    },
    "files": [
      "electron.js",
      "node_modules/",
      "package.json",
      "build/"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|svg|png|jpg|woff2?)$": "<rootDir>/test/styleStub.js"
    },
    "resetMocks": true
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.20.0",
    "babel-jest": "^30.5.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "vite": "^8.3.4",
    "web-vitals": "^2.1.4"
  }
}

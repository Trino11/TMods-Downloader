{
  "name": "tmods-downloader",
  "version": "0.4.2",
  "main": "./build/electron.js",
  "author": "Trino",
  "description": "A minecraft mods manager",
  "private": true,
  "homepage": "./",
  "scripts": {
    "start": "npm run build-react && concurrently -k \"npm run start-react\" \"npm run start-electron -- --dev\"",
    "start-react": "vite",
    "start-electron": "electron .",
    "build": "npm run build-react && npm run dist",
    "build-react": "vite build",
    "test": "jest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.trinohost.tmod_loader",
    "productName": "Tmods Downloader",
    "publish": [
      {
        "provider": "github",
        "owner": "Trino11",
        "repo": "TMods-Downloader",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "artifactName": "Tmods-Downloader.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "Tmods-Downloader-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "Tmods-Downloader.${ext}",
      "syncDesktopName": true
    },
    "files": [
      "node_modules/",
      "package.json",
      "build/"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|svg|png|jpg|woff2?)$": "<rootDir>/test/styleStub.js"
    },
    "resetMocks": true
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "axios": "^1.20.0",
    "babel-jest": "^30.5.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "vite": "^8.3.4"
  },
  "desktopName": "tmods-downloader.desktop"
}
